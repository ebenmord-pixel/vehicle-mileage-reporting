<%- include('../partials/top') %>
<% var ret = '/debriefs/' + d.id; %>
<div class="page-head">
  <div>
    <div class="muted">תחקיר <%= d.number %> · נפתח ע"י <%= userName(d.createdBy) %> · <%= fmtDateTime(d.createdAt) %></div>
    <h1><%= d.title %></h1>
    <div class="badges">
      <%- include('../partials/badge', { item: C.debriefStatus(d.status) }) %>
      <%- include('../partials/badge', { item: Object.assign({}, C.severity(d.severity), { label: 'חומרה: ' + C.severity(d.severity).label }) }) %>
      <% if (d.category) { %><span class="badge badge-gray"><%= d.category %></span><% } %>
    </div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/debriefs/<%= d.id %>/present">▶ הצגה בישיבה</a>
    <details class="menu">
      <summary class="btn btn-ghost">ייצוא ▾</summary>
      <div class="menu-list">
        <a href="/debriefs/<%= d.id %>/print" target="_blank">🖨 הדפסה / שמירה כ-PDF</a>
        <a href="/debriefs/<%= d.id %>/export.pptx">⬇ ייצוא ל-PowerPoint</a>
      </div>
    </details>
    <% if (manage) { %><a class="btn btn-ghost" href="/debriefs/<%= d.id %>/edit">✎ עריכה</a><% } %>
  </div>
</div>

<% if (myParticipation && myParticipation.status !== 'submitted') { %>
  <div class="alert alert-info">הוקצית לתחקיר זה כנציג/ת <b><%= deptName(myParticipation.departmentId) %></b>. <a class="btn btn-sm btn-primary" href="/respond/<%= myParticipation.token %>">למילוי החלק שלי</a></div>
<% } %>

<% if (manage) { %>
<form method="POST" action="/debriefs/<%= d.id %>/status" class="status-flow card">
  <span class="muted">שלב:</span>
  <% C.DEBRIEF_STATUSES.forEach(function(s, i){ var cur = C.DEBRIEF_STATUSES.findIndex(function(x){return x.key===d.status}); %>
    <button name="status" value="<%= s.key %>" class="flow-step <%= i < cur ? 'past' : '' %> <%= s.key === d.status ? 'current' : '' %>"><%= s.label %></button>
  <% }) %>
</form>
<% } %>

<nav class="subnav">
  <a href="#details">פרטי האירוע</a><a href="#participants">משתתפים (<%= d.participants.length %>)</a><a href="#responses">התייחסויות</a>
  <a href="#meeting">ישיבה</a><a href="#findings">ממצאים (<%= d.findings.length %>)</a><a href="#conclusions">מסקנות (<%= d.conclusions.length %>)</a>
  <a href="#tasks">משימות (<%= tasks.length %>)</a><a href="#attachments">נספחים (<%= (d.attachments || []).length %>)</a><a href="#activity">יומן</a>
</nav>

<section id="details" class="card">
  <h2>פרטי האירוע</h2>
  <dl class="details">
    <dt>תאריך ושעה</dt><dd><%= fmtDate(d.eventDate) %> <%= d.eventTime %></dd>
    <dt>מיקום</dt><dd><%= d.location || '-' %></dd>
    <dt>מחלקה מובילה</dt><dd><%= deptName(d.leadDepartmentId) %></dd>
    <dt>Owner התחקיר</dt><dd><%= userName(d.facilitatorId) %></dd>
    <dt>מילוי התייחסויות עד</dt><dd><%= fmtDate(d.responseDueDate) %></dd>
    <dt>תזכורת למשתתפים</dt><dd><%= d.reminderDays === 0 ? 'כבויה' : 'כל ' + (d.reminderDays || settings.responseReminderDays) + ' ימים' %></dd>
  </dl>
  <h3>מה קרה?</h3>
  <div class="prose"><%- nl2br(d.summary) %></div>
  <div class="grid-2">
    <div><h3>השפעה / נזק</h3><div class="prose"><%- nl2br(d.impact || '-') %></div></div>
    <div><h3>פעולות מיידיות</h3><div class="prose"><%- nl2br(d.immediateActions || '-') %></div></div>
  </div>
  <% if (d.timeline.length) { %>
  <h3>ציר זמן (פותח התחקיר)</h3>
  <ul class="timeline">
    <% d.timeline.forEach(function(t){ %><li><span class="tl-when"><%= t.date ? fmtDate(t.date) : '' %> <%= t.time %></span><%= t.description %></li><% }) %>
  </ul>
  <% } %>
</section>

<section id="participants" class="card">
  <div class="section-head">
    <h2>משתתפים לפי מחלקות</h2>
    <% if (manage && d.participants.some(function(p){return p.status !== 'submitted'})) { %>
      <form method="POST" action="/debriefs/<%= d.id %>/remind-pending" class="inline"><button class="btn btn-sm btn-secondary">✉ תזכורת לכל מי שטרם מילא</button></form>
    <% } %>
  </div>
  <% if (!mailConfigured && manage) { %><p class="alert alert-warning small">שליחת מיילים לא הוגדרה (SMTP). המיילים נשמרים ב-data/outbox.log — בינתיים אפשר להעתיק לכל משתתף את הקישור האישי ולשלוח ידנית.</p><% } %>
  <% var submittedCount = d.participants.filter(function(p){return p.status==='submitted'}).length; %>
  <% if (d.participants.length) { %>
    <%- include('../partials/progress', { value: Math.round(submittedCount / d.participants.length * 100) }) %>
    <p class="muted small"><%= submittedCount %> מתוך <%= d.participants.length %> הגישו</p>
  <table class="table">
    <thead><tr><th>מחלקה</th><th>משתתף</th><th>מה התבקש</th><th>סטטוס</th><th>מייל אחרון</th><th></th></tr></thead>
    <tbody>
    <% d.participants.forEach(function(p){ var u = users.find(function(x){return x.id===p.userId}) || {}; %>
      <tr>
        <td><%= deptName(p.departmentId) %></td>
        <td><%= userName(p.userId) %><div class="muted small" dir="ltr"><%= u.email || 'אין מייל' %></div></td>
        <td class="small"><%= p.request || '-' %></td>
        <td><% if (p.status === 'submitted') { %><span class="badge badge-green">הוגש <%= fmtDateTime(p.submittedAt) %></span>
            <% } else if (p.status === 'draft') { %><span class="badge badge-yellow">טיוטה</span>
            <% } else { %><span class="badge badge-gray">ממתין</span><% } %></td>
        <td class="small"><%= p.invitedAt ? fmtDateTime(p.invitedAt) : 'לא נשלח' %><% if (p.lastEmailResult && p.lastEmailResult !== 'נשלח') { %><div class="text-warning small"><%= p.lastEmailResult %></div><% } %></td>
        <td class="nowrap">
          <% if (manage) { %>
            <button type="button" class="btn btn-sm btn-ghost" data-copy="/respond/<%= p.token %>" title="העתקת קישור אישי">🔗</button>
            <% if (p.status !== 'submitted') { %>
              <form method="POST" action="/debriefs/<%= d.id %>/participants/<%= p.id %>/remind" class="inline"><button class="btn btn-sm btn-ghost" title="שליחת מייל">✉</button></form>
            <% } else { %>
              <form method="POST" action="/debriefs/<%= d.id %>/participants/<%= p.id %>/reopen" class="inline" data-confirm="לפתוח מחדש לעריכה?"><button class="btn btn-sm btn-ghost" title="פתיחה מחדש לעריכה">↺</button></form>
            <% } %>
            <form method="POST" action="/debriefs/<%= d.id %>/participants/<%= p.id %>/delete" class="inline" data-confirm="להסיר את המשתתף מהתחקיר?"><button class="btn btn-sm btn-ghost text-danger" title="הסרה">✕</button></form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } else { %><p class="muted">טרם הוקצו משתתפים.</p><% } %>

  <% if (manage) { %>
  <details class="assign" <%= d.participants.length ? '' : 'open' %>>
    <summary class="btn btn-primary">+ הקצאת משתתפים רלוונטיים</summary>
    <form method="POST" action="/debriefs/<%= d.id %>/participants" class="form">
      <p class="muted small">בחרו את המחלקות שזוהו כבעלות חלק בתקלה, ובתוכן את המשתמשים הרלוונטיים. כל משתמש יקבל מייל עם קישור אישי למילוי החלק שלו.</p>
      <input type="search" class="user-filter" placeholder="חיפוש משתמש...">
      <div class="dept-grid">
        <% usersByDept.forEach(function(g){ if (!g.users.length) return; %>
        <fieldset class="dept-box">
          <legend><label><input type="checkbox" class="dept-all"> <%= g.dep.name %></label></legend>
          <% g.users.forEach(function(u){ var already = d.participants.some(function(p){return p.userId===u.id}); %>
            <label class="user-pick <%= already ? 'disabled' : '' %>" data-name="<%= u.fullName %>">
              <input type="checkbox" name="picks" value="<%= u.id %>:<%= g.dep.id %>" <%= already ? 'disabled checked' : '' %>>
              <%= u.fullName %> <span class="muted small"><%= u.jobTitle || '' %><%= g.dep.managerId === u.id ? ' · מנהל/ת המחלקה' : '' %><%= u.email ? '' : ' · אין מייל' %></span>
            </label>
          <% }) %>
        </fieldset>
        <% }) %>
        <% if (noDeptUsers.length) { %>
        <fieldset class="dept-box"><legend>ללא מחלקה</legend>
          <% noDeptUsers.forEach(function(u){ %><label class="user-pick" data-name="<%= u.fullName %>"><input type="checkbox" name="picks" value="<%= u.id %>:0"> <%= u.fullName %></label><% }) %>
        </fieldset>
        <% } %>
      </div>
      <label>מה מבקשים מהמשתתפים? (יופיע במייל)<textarea name="request" rows="2" placeholder="לדוגמה: נא לפרט את השתלשלות האירועים מצד המשמרת ואת הגורמים לדעתכם"></textarea></label>
      <label class="checkbox"><input type="checkbox" name="sendEmail" checked> שליחת מייל הזמנה למשתתפים שנבחרו</label>
      <button class="btn btn-primary">הקצאה</button>
    </form>
  </details>
  <% } %>
</section>

<section id="responses" class="card">
  <h2>התייחסויות המשתתפים</h2>
  <% var subs = d.participants.filter(function(p){ return p.status === 'submitted' || (manage && p.status === 'draft'); }); %>
  <% if (!subs.length) { %><p class="muted">עדיין לא הוגשו התייחסויות.</p><% } %>
  <% subs.forEach(function(p){ %>
    <details class="response" open>
      <summary><b><%= deptName(p.departmentId) %></b> — <%= userName(p.userId) %> <%= p.status === 'draft' ? '(טיוטה)' : '' %></summary>
      <% C.RESPONSE_FIELDS.forEach(function(f){ if (!p.response[f.key]) return; %>
        <h4><%= f.label %></h4><div class="prose"><%- nl2br(p.response[f.key]) %></div>
      <% }) %>
      <% if ((p.response.timeline || []).length) { %>
        <h4>ציר זמן</h4>
        <ul class="timeline"><% p.response.timeline.forEach(function(t){ %><li><span class="tl-when"><%= t.date ? fmtDate(t.date) : '' %> <%= t.time %></span><%= t.description %></li><% }) %></ul>
      <% } %>
    </details>
  <% }) %>
</section>

<section id="meeting" class="card">
  <h2>ישיבת התחקיר</h2>
  <% if (manage) { %>
  <form method="POST" action="/debriefs/<%= d.id %>/meeting" class="form">
    <input type="hidden" name="attendeesSubmitted" value="1">
    <div class="grid-3">
      <label>תאריך<input type="date" name="date" value="<%= d.meeting.date %>"></label>
      <label>שעה<input type="time" name="time" value="<%= d.meeting.time %>"></label>
      <label>מיקום / קישור Teams<input name="location" value="<%= d.meeting.location %>"></label>
    </div>
    <label>משתתפי הישיבה</label>
    <div class="chips">
      <% users.forEach(function(u){ var on = (d.meeting.attendees || []).includes(u.id) || (!(d.meeting.attendees || []).length && d.participants.some(function(p){return p.userId===u.id})); %>
        <label class="chip"><input type="checkbox" name="attendees" value="<%= u.id %>" <%= on ? 'checked' : '' %>> <%= u.fullName %></label>
      <% }) %>
    </div>
    <label>סיכום / הערות מהישיבה<textarea name="notes" rows="3"><%= d.meeting.notes %></textarea></label>
    <label class="checkbox"><input type="checkbox" name="sendInvite"> שליחת זימון במייל למשתתפי הישיבה</label>
    <div class="form-actions">
      <button class="btn">שמירת פרטי ישיבה</button>
    </div>
  </form>
  <form method="POST" action="/debriefs/<%= d.id %>/start-meeting" class="inline"><button class="btn btn-primary">▶ התחלת ישיבה (מעבר למצגת)</button></form>
  <% } else { %>
    <p>מועד: <%= fmtDate(d.meeting.date) %> <%= d.meeting.time %> · מיקום: <%= d.meeting.location || '-' %></p>
    <div class="prose"><%- nl2br(d.meeting.notes) %></div>
  <% } %>
</section>

<section id="findings" class="card">
  <h2>ממצאים</h2>
  <%- include('../partials/findings', { d: d, manage: manage, ret: ret + '#findings', departments: departments }) %>
</section>

<section id="conclusions" class="card">
  <h2>מסקנות ולקחים</h2>
  <%- include('../partials/conclusions', { d: d, manage: manage, ret: ret + '#conclusions', tasks: tasks }) %>
</section>

<section id="tasks" class="card">
  <div class="section-head">
    <h2>משימות לשיפור</h2>
    <% if (manage) { %><a class="btn btn-primary btn-sm" href="/tasks/new?debriefId=<%= d.id %>&returnTo=<%= encodeURIComponent(ret + '#tasks') %>">+ משימה</a><% } %>
  </div>
  <%- include('../partials/task-table', { tasks: tasks, showDebrief: false }) %>
</section>

<section id="attachments" class="card">
  <h2>נספחים</h2>
  <% var atts = d.attachments || []; %>
  <% if (!atts.length) { %><p class="muted">אין נספחים.</p><% } %>
  <div class="attachments">
    <% atts.forEach(function(a){ var img = /^image\//.test(a.mimeType); var url = '/debriefs/' + d.id + '/attachments/' + a.id; %>
      <div class="att">
        <a href="<%= url %>?inline=1" target="_blank" class="att-thumb">
          <% if (img) { %><img src="<%= url %>?inline=1" alt="<%= a.originalName %>" loading="lazy"><% } else { %><span class="att-ext"><%= (a.originalName.split('.').pop() || '').toUpperCase() %></span><% } %>
        </a>
        <div class="att-info">
          <a href="<%= url %>"><b><%= a.originalName %></b></a>
          <div class="muted small"><%= (a.size / 1024 / 1024).toFixed(2) %>MB · <%= userName(a.uploadedBy) %> · <%= fmtDateTime(a.uploadedAt) %></div>
          <% if (a.description) { %><div class="small"><%= a.description %></div><% } %>
          <div class="row">
            <% if (manage) { %>
              <form method="POST" action="<%= url %>/toggle" class="inline"><button class="btn btn-xs <%= a.showInPresentation ? 'btn-secondary' : 'btn-ghost' %>"><%= a.showInPresentation ? '✔ מוצג במצגת' : 'הצג במצגת' %></button></form>
            <% } %>
            <% if (manage || a.uploadedBy === user.id) { %>
              <form method="POST" action="<%= url %>/delete" class="inline" data-confirm="למחוק את הנספח?"><button class="btn btn-xs btn-ghost text-danger">מחיקה</button></form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <form method="POST" action="/debriefs/<%= d.id %>/attachments" enctype="multipart/form-data" class="form add-item">
    <input type="file" name="files" multiple required>
    <div class="row">
      <input name="description" placeholder="תיאור הנספח (לא חובה)">
      <label class="checkbox"><input type="checkbox" name="showInPresentation" checked> הצג במצגת</label>
      <button class="btn btn-primary">⬆ העלאה</button>
    </div>
    <p class="muted small">תמונות, PDF, Word, Excel, PowerPoint ועוד — עד 10 קבצים בכל העלאה.</p>
  </form>
</section>

<section class="card">
  <h2>סיכום התחקיר</h2>
  <% if (manage) { %>
  <form method="POST" action="/debriefs/<%= d.id %>/closing" class="form">
    <textarea name="closingSummary" rows="3" placeholder="שורה תחתונה: מה למדנו ומה משתנה מעכשיו"><%= d.closingSummary %></textarea>
    <button class="btn btn-sm">שמירה</button>
  </form>
  <% } else { %><div class="prose"><%- nl2br(d.closingSummary || '-') %></div><% } %>
</section>

<section id="activity" class="card">
  <h2>יומן פעילות</h2>
  <ul class="activity">
    <% activity.forEach(function(a){ %><li><span class="muted small"><%= fmtDateTime(a.at) %></span> <b><%= a.userId ? userName(a.userId) : 'מערכת' %></b> <%= a.text %></li><% }) %>
  </ul>
  <% if (manage && (user.role === 'admin' || user.id === d.createdBy)) { %>
  <form method="POST" action="/debriefs/<%= d.id %>/delete" data-confirm="למחוק את התחקיר וכל המשימות שלו? פעולה זו אינה הפיכה." class="danger-zone">
    <button class="btn btn-sm btn-danger">מחיקת תחקיר</button>
  </form>
  <% } %>
</section>
<%- include('../partials/bottom') %>
