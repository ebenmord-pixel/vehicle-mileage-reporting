<%# tasks, showDebrief %>
<% if (!tasks.length) { %><p class="muted">אין משימות.</p><% } else { %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>#</th><th>משימה</th><% if (showDebrief) { %><th>תחקיר</th><% } %><th>Owner</th><th>עדיפות</th><th>תאריך יעד</th><th>סטטוס</th><th style="min-width:130px">התקדמות</th><th>עדכון אחרון</th></tr></thead>
  <tbody>
  <% tasks.forEach(function(t){ var dl = daysLeft(t); var last = (t.notes || []).filter(function(n){return n.text && !n.system}).slice(-1)[0]; %>
    <tr class="<%= isOverdue(t) ? 'row-overdue' : '' %>">
      <td><%= t.id %></td>
      <td><a href="/tasks/<%= t.id %>"><b><%= t.title %></b></a></td>
      <% if (showDebrief) { %><td class="small"><% if (t.debriefId) { %><a href="/debriefs/<%= t.debriefId %>"><%= (debriefs.find(function(x){return x.id===t.debriefId}) || {}).number || '' %></a><% } else { %>-<% } %></td><% } %>
      <td><%= userName(t.assigneeId) %><div class="muted small"><%= deptName(t.departmentId) %></div></td>
      <td><%- include('badge', { item: C.priority(t.priority) }) %></td>
      <td class="nowrap"><%= fmtDate(t.dueDate) %>
        <% if (isOverdue(t)) { %><div class="text-danger small">באיחור <%= -dl %> ימים</div><% } else if (dl !== null && !['done','cancelled'].includes(t.status) && dl <= 7) { %><div class="text-warning small">עוד <%= dl %> ימים</div><% } %></td>
      <td><%- include('badge', { item: C.taskStatus(t.status) }) %></td>
      <td><%- include('progress', { value: t.progress || 0 }) %></td>
      <td class="small muted"><%= last ? last.text.slice(0, 60) : '' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>
