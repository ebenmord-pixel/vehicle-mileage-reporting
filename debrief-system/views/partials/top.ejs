<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>ניהול תחקירים</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><span class="logo">◆</span> ניהול תחקירים</a>
  <% if (user) { %>
  <nav class="nav">
    <a href="/" class="<%= path === '/' ? 'active' : '' %>">לוח בקרה</a>
    <a href="/debriefs" class="<%= path.startsWith('/debriefs') ? 'active' : '' %>">תחקירים</a>
    <a href="/tracking" class="<%= path.startsWith('/tracking') ? 'active' : '' %>">מעקב שיפורים</a>
    <a href="/tasks" class="<%= path.startsWith('/tasks') ? 'active' : '' %>">משימות לשיפור</a>
    <% if (user.role === 'admin') { %>
      <a href="/admin/users" class="<%= path.startsWith('/admin') ? 'active' : '' %>">ניהול</a>
    <% } %>
  </nav>
  <div class="who">
    <a href="/profile"><%= user.fullName %></a>
    <form action="/logout" method="POST" class="inline"><button class="link-btn">יציאה</button></form>
  </div>
  <% } %>
</header>
<main class="container">
<% (flash || []).forEach(function(f){ %>
  <div class="alert alert-<%= f.type %>"><%= f.text %></div>
<% }) %>
