<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/present.css">
<style>@page { size: A4 landscape; margin: 0; }</style>
</head>
<body class="print-body">
<div class="print-hint no-print">לשמירה כ-PDF: בחלון ההדפסה בחרו "שמירה כ-PDF", כיוון לרוחב. <button onclick="window.print()" class="btn btn-primary btn-sm">הדפסה</button></div>
<% var d = debrief; %>
<% slides.forEach(function(s, i){ %>
  <section class="slide print-slide slide-<%= s.type %>">
    <% if (s.type === 'cover') { %>
      <div class="cover"><div class="cover-kicker">תחקיר</div><h1><%= d.title %></h1>
        <div class="cover-meta"><div>מס׳ תחקיר: <b><%= d.number %></b></div><div>תאריך האירוע: <b><%= fmtDate(d.eventDate) %></b></div><div>מחלקה מובילה: <b><%= leadDept ? leadDept.name : '-' %></b></div><div>מנחה: <b><%= userName(d.facilitatorId) %></b></div></div></div>
    <% } else { %>
      <header class="slide-head"><h2><%= s.title %></h2></header>
      <div class="slide-content">
      <% if (s.type === 'details') { %>
        <table class="slide-table kv">
          <tr><th>תאריך ושעה</th><td><%= fmtDate(d.eventDate) %> <%= d.eventTime %></td></tr><tr><th>מיקום</th><td><%= d.location || '-' %></td></tr>
          <tr><th>קטגוריה</th><td><%= d.category || '-' %></td></tr><tr><th>חומרה</th><td><%= severity.label %></td></tr>
          <tr><th>השפעה / נזק</th><td><%- nl2br(d.impact || '-') %></td></tr><tr><th>פעולות מיידיות</th><td><%- nl2br(d.immediateActions || '-') %></td></tr>
        </table>
      <% } else if (s.type === 'summary') { %><div class="slide-text"><%- nl2br(d.summary) %></div>
      <% } else if (s.type === 'timeline') { %>
        <ul class="slide-timeline"><% timeline.forEach(function(t){ %><li><span class="when"><%= t.date ? fmtDate(t.date) : '' %> <%= t.time %></span><span class="what"><%= t.description %></span><% if (t.source) { %><span class="src"><%= t.source %></span><% } %></li><% }) %></ul>
      <% } else if (s.type === 'participants') { %>
        <div class="dept-cards"><% Object.keys(deptGroups).forEach(function(name){ %><div class="dept-card"><h3><%= name %></h3><% deptGroups[name].forEach(function(p){ %><div><%= p.user ? p.user.fullName : '-' %></div><% }) %></div><% }) %></div>
      <% } else if (s.type === 'response') { var r = s.participant.response || {}; %>
        <div class="response-grid"><% fields.forEach(function(f){ if (!r[f.key]) return; %><div class="response-box"><h4><%= f.label %></h4><div><%- nl2br(r[f.key]) %></div></div><% }) %></div>
      <% } else if (s.type === 'findings') { %>
        <ol class="items"><% d.findings.forEach(function(f){ %><li class="item item-<%= f.type %>"><div class="item-body"><%- nl2br(f.text) %> <span class="muted small">(<%= C.findingType(f.type).label %><%= f.rootCause ? ' · ' + f.rootCause : '' %>)</span></div></li><% }) %></ol>
      <% } else if (s.type === 'conclusions') { %>
        <ol class="items"><% d.conclusions.forEach(function(c){ %><li class="item"><div class="item-body"><%- nl2br(c.text) %></div></li><% }) %></ol>
      <% } else if (s.type === 'tasks') { %>
        <table class="slide-table"><thead><tr><th>#</th><th>משימה</th><th>Owner</th><th>יעד</th><th>סטטוס</th><th>התקדמות</th></tr></thead><tbody>
        <% tasks.forEach(function(t, k){ %><tr><td><%= k + 1 %></td><td><%= t.title %></td><td><%= t.assignee ? t.assignee.fullName : '-' %></td><td><%= fmtDate(t.dueDate) %></td><td><%= C.taskStatus(t.status).label %></td><td><%= t.progress || 0 %>%</td></tr><% }) %>
        </tbody></table>
      <% } else if (s.type === 'attachments') { %>
        <div class="att-slide"><% s.attachments.forEach(function(a){ var url = '/debriefs/' + d.id + '/attachments/' + a.id; %>
          <% if (/^image\//.test(a.mimeType)) { %><figure><img src="<%= url %>?inline=1" alt=""><figcaption><%= a.description || a.originalName %></figcaption></figure>
          <% } else { %><div class="att-file"><span class="att-ext"><%= (a.originalName.split('.').pop() || '').toUpperCase() %></span><span><%= a.originalName %></span></div><% } %>
        <% }) %></div>
      <% } else if (s.type === 'closing') { %>
        <div class="closing-stats"><div><b><%= d.findings.length %></b><span>ממצאים</span></div><div><b><%= d.conclusions.length %></b><span>מסקנות</span></div><div><b><%= tasks.length %></b><span>משימות</span></div></div>
        <div class="slide-text"><%- nl2br(d.closingSummary) %></div>
      <% } %>
      </div>
    <% } %>
    <footer class="slide-foot"><span>תחקיר <%= d.number %> — <%= d.title %></span><span><%= i + 1 %> / <%= slides.length %></span></footer>
  </section>
<% }) %>
</body>
</html>
