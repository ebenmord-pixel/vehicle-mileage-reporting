<%- include('../partials/top') %>
<div class="page-head">
  <h1>משימות לשיפור</h1>
  <div class="actions">
    <a class="btn btn-ghost <%= view === 'table' ? 'active' : '' %>" href="?<%= new URLSearchParams(Object.assign({}, filters, { view: 'table' })).toString() %>">☰ טבלה</a>
    <a class="btn btn-ghost <%= view === 'board' ? 'active' : '' %>" href="?<%= new URLSearchParams(Object.assign({}, filters, { view: 'board' })).toString() %>">▦ לוח</a>
    <a class="btn btn-secondary" href="/tasks/export.xlsx?<%= new URLSearchParams(filters).toString() %>">⬇ ייצוא לאקסל</a>
    <a class="btn btn-primary" href="/tasks/new">+ משימה</a>
  </div>
</div>
<form class="filters card" method="GET">
  <input type="hidden" name="view" value="<%= view %>">
  <input name="search" value="<%= filters.search || '' %>" placeholder="חיפוש...">
  <select name="status">
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>פעילות (לא הושלמו)</option>
    <option value="" <%= !filters.status ? 'selected' : '' %>>הכול</option>
    <% C.TASK_STATUSES.forEach(function(s){ %><option value="<%= s.key %>" <%= filters.status === s.key ? 'selected' : '' %>><%= s.label %></option><% }) %>
  </select>
  <select name="assignee"><option value="">כל האחראים</option><% users.forEach(function(u){ %><option value="<%= u.id %>" <%= Number(filters.assignee) === u.id ? 'selected' : '' %>><%= u.fullName %></option><% }) %></select>
  <select name="dept"><option value="">כל המחלקות</option><% departments.forEach(function(dp){ %><option value="<%= dp.id %>" <%= Number(filters.dept) === dp.id ? 'selected' : '' %>><%= dp.name %></option><% }) %></select>
  <select name="debrief"><option value="">כל התחקירים</option><% debriefs.forEach(function(d){ %><option value="<%= d.id %>" <%= Number(filters.debrief) === d.id ? 'selected' : '' %>><%= d.number %> — <%= d.title %></option><% }) %></select>
  <label class="checkbox"><input type="checkbox" name="mine" value="1" <%= filters.mine ? 'checked' : '' %>> שלי בלבד</label>
  <label class="checkbox"><input type="checkbox" name="overdue" value="1" <%= filters.overdue ? 'checked' : '' %>> באיחור</label>
  <button class="btn">סינון</button>
</form>

<% if (view === 'board') { %>
  <div class="board">
    <% C.TASK_STATUSES.filter(function(s){ return filters.status === 'active' ? !['done','cancelled'].includes(s.key) : true; }).forEach(function(s){ var col = tasks.filter(function(t){return t.status === s.key}); %>
    <div class="board-col">
      <h3><%- include('../partials/badge', { item: s }) %> <span class="count"><%= col.length %></span></h3>
      <% col.forEach(function(t){ %>
        <a class="board-card <%= isOverdue(t) ? 'row-overdue' : '' %>" href="/tasks/<%= t.id %>">
          <b><%= t.title %></b>
          <div class="muted small"><%= userName(t.assigneeId) %> · יעד <%= fmtDate(t.dueDate) %></div>
          <%- include('../partials/progress', { value: t.progress || 0 }) %>
        </a>
      <% }) %>
    </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card"><%- include('../partials/task-table', { tasks: tasks, showDebrief: true }) %></div>
<% } %>
<%- include('../partials/bottom') %>
