<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <div class="muted">משימה #<%= t.id %><% if (d) { %> · תחקיר <a href="/debriefs/<%= d.id %>"><%= d.number %> — <%= d.title %></a><% } %></div>
    <h1><%= t.title %></h1>
    <div class="badges"><%- include('../partials/badge', { item: C.taskStatus(t.status) }) %> <%- include('../partials/badge', { item: Object.assign({}, C.priority(t.priority), { label: 'עדיפות ' + C.priority(t.priority).label }) }) %>
      <% if (isOverdue(t)) { %><span class="badge badge-red">באיחור <%= -daysLeft(t) %> ימים</span><% } %></div>
  </div>
  <% if (canManageTask) { %>
  <div class="actions">
    <a class="btn btn-ghost" href="/tasks/<%= t.id %>/edit">✎ עריכה</a>
    <form method="POST" action="/tasks/<%= t.id %>/delete" class="inline" data-confirm="למחוק את המשימה?"><button class="btn btn-ghost text-danger">מחיקה</button></form>
  </div>
  <% } %>
</div>
<div class="grid-2">
  <section class="card">
    <dl class="details">
      <dt>Owner</dt><dd><%= userName(t.assigneeId) %> (<%= deptName(t.departmentId) %>)</dd>
      <dt>תאריך יעד</dt><dd><%= fmtDate(t.dueDate) %></dd>
      <dt>נוצרה ע"י</dt><dd><%= userName(t.createdBy) %> · <%= fmtDateTime(t.createdAt) %></dd>
      <dt>תזכורות</dt><dd><%= t.reminderDays === 0 ? 'כבויות' : 'כל ' + (t.reminderDays || settings.taskReminderDays) + ' ימים' %><%= isOverdue(t) && settings.overdueReminderDays && t.reminderDays !== 0 ? ' (באיחור: כל ' + Math.min(t.reminderDays || settings.taskReminderDays, settings.overdueReminderDays) + ')' : '' %>
        <div class="muted small">נשלחו <%= t.reminderCount || 0 %><%= t.lastReminderAt ? ' · אחרונה: ' + fmtDateTime(t.lastReminderAt) : '' %><%= t.lastReminderResult && t.lastReminderResult !== 'נשלח' ? ' · ' + t.lastReminderResult : '' %></div>
        <% if (canEdit && !['done','cancelled'].includes(t.status)) { %><form method="POST" action="/tasks/<%= t.id %>/remind" class="inline"><button class="btn btn-xs btn-secondary">✉ שליחת תזכורת עכשיו</button></form><% } %></dd>
      <% if (t.completedAt) { %><dt>הושלמה</dt><dd><%= fmtDateTime(t.completedAt) %></dd><% } %>
      <% if (t.successCriteria) { %><dt>מדד הצלחה</dt><dd><%= t.successCriteria %></dd><% } %>
    </dl>
    <% if (conclusion) { %><h3>מסקנה קשורה</h3><div class="prose"><%- nl2br(conclusion.text) %></div><% } %>
    <% if (t.description) { %><h3>פירוט</h3><div class="prose"><%- nl2br(t.description) %></div><% } %>
    <h3>התקדמות</h3>
    <%- include('../partials/progress', { value: t.progress || 0 }) %>
  </section>
  <section class="card">
    <h2>עדכון התקדמות</h2>
    <% if (canEdit) { %>
    <form method="POST" action="/tasks/<%= t.id %>/progress" class="form">
      <label>אחוז התקדמות: <output id="pv"><%= t.progress || 0 %></output>%
        <input type="range" name="progress" min="0" max="100" step="5" value="<%= t.progress || 0 %>" oninput="document.getElementById('pv').value=this.value"></label>
      <label>סטטוס<select name="status"><% C.TASK_STATUSES.forEach(function(s){ %><option value="<%= s.key %>" <%= t.status === s.key ? 'selected' : '' %>><%= s.label %></option><% }) %></select></label>
      <label>הערה / עדכון<textarea name="note" rows="3" placeholder="מה בוצע, מה נותר, חסמים..."></textarea></label>
      <button class="btn btn-primary">עדכון</button>
    </form>
    <% } else { %><p class="muted">רק ה-Owner או מנהל התחקיר יכולים לעדכן.</p><% } %>
  </section>
</div>
<section class="card">
  <h2>היסטוריית עדכונים והערות</h2>
  <% if (!(t.notes || []).length) { %><p class="muted">אין עדכונים עדיין</p><% } %>
  <ul class="activity">
    <% (t.notes || []).slice().reverse().forEach(function(n){ %>
      <li><span class="muted small"><%= fmtDateTime(n.at) %></span> <b><%= userName(n.userId) %></b>
        <% if (n.progressFrom !== undefined && n.progressFrom !== n.progressTo) { %><span class="badge badge-blue"><%= n.progressFrom || 0 %>% ← <%= n.progressTo %>%</span><% } %>
        <% if (n.statusFrom && n.statusFrom !== n.statusTo) { %><span class="badge badge-gray"><%= C.taskStatus(n.statusFrom).label %> ← <%= C.taskStatus(n.statusTo).label %></span><% } %>
        <% if (n.text) { %><div class="prose"><%- nl2br(n.text) %></div><% } %></li>
    <% }) %>
  </ul>
</section>
<%- include('../partials/bottom') %>
