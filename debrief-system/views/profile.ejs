<%- include('partials/top') %>
<div class="card narrow">
  <h1>הפרופיל שלי</h1>
  <p class="muted"><%= user.fullName %> · <%= deptName(user.departmentId) %> · <%= user.jobTitle || '' %></p>
  <form method="POST" action="/profile" class="form">
    <label>כתובת מייל (לקבלת הזמנות ותזכורות)<input type="email" name="email" value="<%= user.email %>" dir="ltr"></label>
    <fieldset><legend>החלפת סיסמה (לא חובה)</legend>
      <label>סיסמה נוכחית<input type="password" name="currentPassword" autocomplete="current-password"></label>
      <label>סיסמה חדשה<input type="password" name="newPassword" autocomplete="new-password" minlength="6"></label>
    </fieldset>
    <button class="btn btn-primary">שמירה</button>
  </form>
</div>
<%- include('partials/bottom') %>
