# העתיקו ל-.env ומלאו ערכים אמיתיים (הקובץ .env לא נשמר ב-Git)
PORT=3100
APP_BASE_URL=http://localhost:3100
SESSION_SECRET=change-this-to-a-long-random-string

# שליחת מיילים דרך Microsoft 365 / Outlook (או כל שרת SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=debriefs@yourcompany.com
SMTP_PASS=your-password-or-app-password
MAIL_FROM=debriefs@yourcompany.com

# אופציונלי
TZ=Asia/Jerusalem
MAX_UPLOAD_MB=25
# REMINDERS_ON_WEEKEND=true
# DISABLE_SCHEDULER=true
